# Local development — no GCP account required.
# When you create a GCP project later, fill these in and set THOMAS_MODE=gcp.

THOMAS_MODE=local
PORT=8787
DATA_DIR=./data

# Feeder / visuals point at the API
VITE_API_URL=http://localhost:8787
VITE_VISUALS_URL=http://localhost:5174
VITE_FEEDER_URL=http://localhost:5173

# Cost guardrails
THOMAS_CHEAP_MODEL=gemini-2.0-flash
THOMAS_PRO_MODEL=gemini-2.0-pro
THOMAS_MAX_TOKENS_PER_STAGE=4096
THOMAS_MAX_TOOL_ROUNDS=4

# GCP (unused until you log in — do not run gcloud yet)
# GCP_PROJECT_ID=
# GCP_REGION=us-central1
# GCS_BUCKET=
# FIRESTORE_DATABASE=(default)
# GOOGLE_APPLICATION_CREDENTIALS=
