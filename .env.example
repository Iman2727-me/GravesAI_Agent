# Local development — mock LLM by default ($0).
# For Vertex Gemini (pay-per-token, US-only): set THOMAS_MODE=gcp and GCP_PROJECT_ID.

THOMAS_MODE=local
PORT=8787
DATA_DIR=./data

# Graves Continuum (Universal Personalized Medicine)
CONTINUUM_PORT=8790
CONTINUUM_DATA_DIR=./data/continuum

# Feeder / visuals point at the API
VITE_API_URL=http://localhost:8787
VITE_VISUALS_URL=http://localhost:5174
VITE_FEEDER_URL=http://localhost:5173

# Continuum console (leave empty in dev to use Vite proxy → :8790)
# VITE_API_URL=http://localhost:8790

# Cost guardrails (Flash for questions + most stages; Pro only for heavy stages)
THOMAS_CHEAP_MODEL=gemini-2.5-flash
THOMAS_PRO_MODEL=gemini-2.5-pro
THOMAS_MAX_TOKENS_PER_STAGE=4096
THOMAS_MAX_TOOL_ROUNDS=4

# GCP / Vertex (local API + Vertex tokens; store stays on disk until you deploy)
# GCP_PROJECT_ID=gravesaiagent
# GCP_REGION=us-central1
# GCS_BUCKET=
# FIRESTORE_DATABASE=(default)
# GOOGLE_APPLICATION_CREDENTIALS=
